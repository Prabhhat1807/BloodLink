# =============================================================================
# BloodLink — Environment Configuration Template (.env.example)
# =============================================================================
# Instructions:
# 1. Copy this file to '.env':
#    Windows PowerShell: Copy-Item .env.example .env
#    Linux/macOS:        cp .env.example .env
# 2. Replace the placeholder values below with your local environment settings.
# 3. NEVER commit the real '.env' file containing actual secrets to version control.
# =============================================================================

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=blood_donation

# Flask Application & Session Security
# Generate a cryptographically secure 64-char key in terminal using:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secure_random_flask_secret_key_here
FLASK_SECRET_KEY=your_secure_random_flask_secret_key_here

# Cookie Security Configuration
# Set to 'True' only when serving behind an SSL/HTTPS reverse proxy in production.
# Keep 'False' for local HTTP development (localhost).
SESSION_COOKIE_SECURE=False
